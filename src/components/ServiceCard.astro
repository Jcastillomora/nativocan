---
interface Props {
  title: string;
  description: string;
  icon: string;
  duration: string;
  highlights: string[];
}

const { title, description, icon, duration, highlights } = Astro.props;
---

<div class="bg-white rounded-lg shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300 p-6 md:p-8">
  <!-- Icon -->
  <div class="text-5xl mb-4">{icon}</div>

  <!-- Title -->
  <h3 class="text-2xl font-semibold mb-3 text-neutral-900">{title}</h3>

  <!-- Description -->
  <p class="text-neutral-600 mb-4">{description}</p>

  <!-- Duration Badge -->
  <div class="inline-block bg-primary/10 text-primary px-4 py-2 rounded-full text-sm font-semibold mb-4">
    {duration}
  </div>

  <!-- Highlights -->
  <ul class="space-y-2">
    {highlights.map(highlight => (
      <li class="flex items-start gap-2 text-neutral-700">
        <svg class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
        </svg>
        <span>{highlight}</span>
      </li>
    ))}
  </ul>
</div>
