---
interface Props {
  name: string;
  dogName: string;
  photo: string;
  rating: number;
  text: string;
  service: string;
}

const { name, dogName, photo, rating, text, service } = Astro.props;
---

<div class="bg-white rounded-lg shadow-md p-6 min-w-full md:min-w-[33.333%]">
  <div class="flex items-center gap-4 mb-4">
    <div class="w-16 h-16 bg-neutral-200 rounded-full flex items-center justify-center text-3xl">
      🐕
    </div>
    <div>
      <h4 class="font-semibold text-neutral-900">{name}</h4>
      <p class="text-sm text-neutral-600">{dogName}</p>
    </div>
  </div>
  <div class="flex gap-1 mb-3">
    {Array.from({ length: rating }).map(() => (
      <span class="text-primary text-xl">★</span>
    ))}
  </div>
  <p class="text-neutral-700 mb-3 italic">"{text}"</p>
  <span class="inline-block bg-primary/10 text-primary px-3 py-1 rounded-full text-sm font-medium">{service}</span>
</div>
