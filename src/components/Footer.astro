---
// Footer.astro
import { siteData } from '../data/site.js';
---

<footer class="bg-secondary-dark text-white py-12">
  <div class="container mx-auto px-4 max-w-7xl">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <!-- Column 1: Logo and tagline -->
      <div>
        <h3 class="text-2xl font-bold mb-4">{siteData.business.name}</h3>
        <p class="text-neutral-300 mb-4">{siteData.business.tagline}</p>
        <p class="text-neutral-400 text-sm">{siteData.business.description}</p>
      </div>

      <!-- Column 2: Quick links -->
      <div>
        <h4 class="text-lg font-semibold mb-4">Enlaces Rápidos</h4>
        <ul class="space-y-2">
          <li>
            <a href="#servicios" class="text-neutral-300 hover:text-primary transition-colors">
              Servicios
            </a>
          </li>
          <li>
            <a href="#hotel" class="text-neutral-300 hover:text-primary transition-colors">
              Hotel
            </a>
          </li>
          <li>
            <a href="#equipo" class="text-neutral-300 hover:text-primary transition-colors">
              Equipo
            </a>
          </li>
          <li>
            <a href="#testimonios" class="text-neutral-300 hover:text-primary transition-colors">
              Testimonios
            </a>
          </li>
          <li>
            <a href="#precios" class="text-neutral-300 hover:text-primary transition-colors">
              Precios
            </a>
          </li>
          <li>
            <a href="#contacto" class="text-neutral-300 hover:text-primary transition-colors">
              Contacto
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Contact info and social -->
      <div>
        <h4 class="text-lg font-semibold mb-4">Contacto</h4>
        <div class="space-y-3 mb-6">
          <p class="text-neutral-300">
            <span class="font-semibold">Teléfono:</span><br />
            <a href={`tel:${siteData.business.phone}`} class="hover:text-primary transition-colors">
              {siteData.business.phone}
            </a>
          </p>
          <p class="text-neutral-300">
            <span class="font-semibold">Email:</span><br />
            <a href={`mailto:${siteData.business.email}`} class="hover:text-primary transition-colors break-all">
              {siteData.business.email}
            </a>
          </p>
        </div>

        <!-- Social icons -->
        <div class="flex gap-4">
          <a
            href={siteData.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 bg-white/10 rounded-full flex items-center justify-center hover:bg-primary transition-colors"
            aria-label="Facebook"
          >
            📘
          </a>
          <a
            href={siteData.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 bg-white/10 rounded-full flex items-center justify-center hover:bg-primary transition-colors"
            aria-label="Instagram"
          >
            📷
          </a>
          <a
            href={`https://wa.me/${siteData.social.whatsapp}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 bg-white/10 rounded-full flex items-center justify-center hover:bg-primary transition-colors"
            aria-label="WhatsApp"
          >
            💬
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-neutral-400 text-sm">
        © 2024 {siteData.business.name}. Todos los derechos reservados.
      </p>
      <div class="flex gap-6 text-sm">
        <a href="#" class="text-neutral-400 hover:text-primary transition-colors">
          Política de Privacidad
        </a>
        <a href="#" class="text-neutral-400 hover:text-primary transition-colors">
          Términos y Condiciones
        </a>
      </div>
    </div>
  </div>
</footer>
