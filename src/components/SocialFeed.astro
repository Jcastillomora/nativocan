      <!-- TikTok Embed Container -->
      <div class="tiktok-feed-container">
        <div class="text-center py-12 bg-white rounded-lg shadow-inner">
          <p class="text-neutral-600 mb-4">
            🎵 Feed de TikTok
          </p>
          <p class="text-sm text-neutral-500 mb-6 max-w-md mx-auto">
            Para activar el feed automático de TikTok, usa el
            <a href="https://www.tiktok.com/embed" target="_blank" class="text-primary hover:underline">TikTok Embed</a>
          </p>

          <!-- Manual TikTok Videos Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8 max-w-5xl mx-auto">
            <!-- Placeholder videos - Replace with actual TikTok embeds -->
            <a
              href="https://www.tiktok.com/@nativocan.cl"
              target="_blank"
              rel="noopener noreferrer"
              class="aspect-[9/16] bg-gradient-to-br from-cyan-400 via-blue-500 to-purple-600 rounded-lg hover:opacity-90 transition-opacity flex items-center justify-center text-white text-5xl relative overflow-hidden"
            >
              <div class="absolute inset-0 bg-black/20"></div>
              <span class="relative">▶️</span>
            </a>
            <a
              href="https://www.tiktok.com/@nativocan.cl"
              target="_blank"
              rel="noopener noreferrer"
              class="aspect-[9/16] bg-gradient-to-br from-pink-400 via-red-500 to-yellow-600 rounded-lg hover:opacity-90 transition-opacity flex items-center justify-center text-white text-5xl relative overflow-hidden"
            >
              <div class="absolute inset-0 bg-black/20"></div>
              <span class="relative">🎬</span>
            </a>
            <a
              href="https://www.tiktok.com/@nativocan.cl"
              target="_blank"
              rel="noopener noreferrer"
              class="aspect-[9/16] bg-gradient-to-br from-green-400 via-teal-500 to-blue-600 rounded-lg hover:opacity-90 transition-opacity flex items-center justify-center text-white text-5xl relative overflow-hidden"
            >
              <div class="absolute inset-0 bg-black/20"></div>
              <span class="relative">🐕</span>
            </a>
          </div>
        </div>

        <!-- Instructions for setup -->
        <div class="mt-6 p-4 bg-purple-50 border border-purple-200 rounded-lg">
          <h4 class="font-semibold text-purple-900 mb-2">🔧 Configuración del Feed de TikTok:</h4>
          <ol class="text-sm text-purple-800 space-y-1 ml-4 list-decimal">
            <li>Visitar <a href="https://www.tiktok.com/embed" target="_blank" class="underline">TikTok Embed Generator</a></li>
            <li>Ingresar el URL de tu perfil: @nativocan.cl</li>
            <li>Generar el código embed para profile o videos individuales</li>
            <li>Reemplazar este contenido con los iframes generados</li>
          </ol>
        </div>
      </div>
    </div>

    <!-- CTA to follow -->
    <div class="text-center mt-12">
      <p class="text-neutral-600 mb-4">¿Te gusta nuestro contenido?</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="https://www.instagram.com/nativocan.cl/"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-gradient-to-r from-purple-500 to-pink-500 hover:from-purple-600 hover:to-pink-600 text-white font-semibold px-8 py-3 rounded-full transition-all duration-300 shadow-md hover:shadow-lg inline-flex items-center gap-2"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          Seguir en Instagram
        </a>
        <a
          href="https://www.tiktok.com/@nativocan.cl"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-gradient-to-r from-cyan-500 to-purple-500 hover:from-cyan-600 hover:to-purple-600 text-white font-semibold px-8 py-3 rounded-full transition-all duration-300 shadow-md hover:shadow-lg inline-flex items-center gap-2"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1-.1z"/>
          </svg>
          Seguir en TikTok
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // Social feed tab switching
  const tabs = document.querySelectorAll('[data-social-tab]');
  const contents = document.querySelectorAll('[data-social-content]');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.socialTab;

      // Update tabs
      tabs.forEach(t => {
        if (t.dataset.socialTab === target) {
          t.classList.remove('bg-neutral-200', 'text-neutral-700', 'hover:bg-neutral-300');
          t.classList.add('bg-primary', 'text-white', 'shadow-md', 'active');
        } else {
          t.classList.remove('bg-primary', 'text-white', 'shadow-md', 'active');
          t.classList.add('bg-neutral-200', 'text-neutral-700', 'hover:bg-neutral-300');
        }
      });

      // Update content
      contents.forEach(content => {
        if (content.dataset.socialContent === target) {
          content.classList.remove('hidden');
          // Fade in animation
          content.style.opacity = '0';
          setTimeout(() => {
            content.style.transition = 'opacity 0.3s ease-in';
            content.style.opacity = '1';
          }, 10);
        } else {
          content.classList.add('hidden');
        }
      });
    });
  });
</script>

<style>
  .social-content {
    animation: fadeIn 0.3s ease-in;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .social-tab {
    position: relative;
  }

  .social-tab.active::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    width: 40%;
    height: 3px;
    background: currentColor;
    border-radius: 2px;
  }
</style>
