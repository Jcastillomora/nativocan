          </svg>
          @nativocan.cl
        </a>
      </div>

      <!-- Instagram Embed Container -->
      <div class="instagram-feed-container">
        <!-- Option 1: Using Instagram embed widget (recommended) -->
        <div class="text-center py-12 bg-white rounded-lg shadow-inner">
          <p class="text-neutral-600 mb-4">
            📸 Feed de Instagram
          </p>
          <p class="text-sm text-neutral-500 mb-6 max-w-md mx-auto">
            Para activar el feed automático de Instagram, usa un servicio como
            <a href="https://elfsight.com/instagram-feed-instashow/" target="_blank" class="text-primary hover:underline">Elfsight</a> o
            <a href="https://embedsocial.com/products/embedfeed/" target="_blank" class="text-primary hover:underline">EmbedSocial</a>
          </p>

          <!-- Manual Instagram Posts Grid -->
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 mt-8">
            <!-- Placeholder posts - Replace with actual Instagram embed code -->
            <a
              href="https://www.instagram.com/nativocan.cl/"
              target="_blank"
              rel="noopener noreferrer"
              class="aspect-square bg-gradient-to-br from-purple-400 via-pink-500 to-red-500 rounded-lg hover:opacity-90 transition-opacity flex items-center justify-center text-white text-4xl"
            >
              📷
            </a>
            <a
              href="https://www.instagram.com/nativocan.cl/"
              target="_blank"
              rel="noopener noreferrer"
              class="aspect-square bg-gradient-to-br from-blue-400 via-purple-500 to-pink-500 rounded-lg hover:opacity-90 transition-opacity flex items-center justify-center text-white text-4xl"
            >
              🐕
            </a>
            <a
              href="https://www.instagram.com/nativocan.cl/"
              target="_blank"
              rel="noopener noreferrer"
              class="aspect-square bg-gradient-to-br from-green-400 via-blue-500 to-purple-500 rounded-lg hover:opacity-90 transition-opacity flex items-center justify-center text-white text-4xl"
            >
              🎾
            </a>
            <a
              href="https://www.instagram.com/nativocan.cl/"
              target="_blank"
              rel="noopener noreferrer"
              class="aspect-square bg-gradient-to-br from-yellow-400 via-orange-500 to-red-500 rounded-lg hover:opacity-90 transition-opacity flex items-center justify-center text-white text-4xl"
            >
              ⭐
            </a>
          </div>
        </div>

        <!-- Instructions for setup -->
        <div class="mt-6 p-4 bg-blue-50 border border-blue-200 rounded-lg">
          <h4 class="font-semibold text-blue-900 mb-2">🔧 Configuración del Feed de Instagram:</h4>
          <ol class="text-sm text-blue-800 space-y-1 ml-4 list-decimal">
            <li>Registrarse en <a href="https://embedsocial.com" target="_blank" class="underline">EmbedSocial</a> (gratis)</li>
            <li>Conectar tu cuenta de Instagram @nativocan.cl</li>
            <li>Generar el código embed</li>
            <li>Reemplazar este contenido con el script generado</li>
          </ol>
        </div>
      </div>
    </div>

    <!-- TikTok Feed Section -->
    <div data-social-content="tiktok" class="social-content hidden">
      <div class="mb-8 text-center">
        <a
          href="https://www.tiktok.com/@nativocan.cl"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-primary hover:text-primary-dark transition-colors font-semibold text-lg"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1-.1z"/>
