<!-- Instagram Embed Script -->
<script async src="//www.instagram.com/embed.js"></script>

<!-- TikTok Embed Script - Deferred loading to avoid overload-protect -->
<script>
  // Wait for DOM to be ready before loading TikTok script
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadTikTokScript);
  } else {
    loadTikTokScript();
  }

  function loadTikTokScript() {
    // Avoid loading if already loaded
    if (document.querySelector('script[src*="tiktok.com/embed.js"]')) {
      return;
    }

    const script = document.createElement('script');
    script.src = 'https://www.tiktok.com/embed.js';
    script.defer = true; // Use defer instead of async

    script.onerror = function() {
      console.error('Failed to load TikTok embed script');
    };

    document.body.appendChild(script);
  }
</script>

<script>
  // Reinitialize Instagram embeds when switching tabs
  document.addEventListener('DOMContentLoaded', function() {
    // Load Instagram script if not already loaded
    if (!window.instgrm) {
      const script = document.createElement('script');
      script.src = '//www.instagram.com/embed.js';
      script.async = true;
      script.onload = () => {
        if (window.instgrm) {
          window.instgrm.Embeds.process();
        }
      };
      document.body.appendChild(script);
    } else {
      // Process embeds if script already loaded
      window.instgrm.Embeds.process();
    }
  });
</script>

<script is:inline>
  // Social feed tab switching
  document.addEventListener('DOMContentLoaded', function() {
    const tabs = document.querySelectorAll('[data-social-tab]');
    const contents = document.querySelectorAll('[data-social-content]');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.socialTab;

        // Update tabs
        tabs.forEach(t => {
          if (t.dataset.socialTab === target) {
            t.classList.remove('bg-neutral-200', 'text-neutral-700', 'hover:bg-neutral-300');
            t.classList.add('bg-primary', 'text-white', 'shadow-md', 'active');
          } else {
            t.classList.remove('bg-primary', 'text-white', 'shadow-md', 'active');
            t.classList.add('bg-neutral-200', 'text-neutral-700', 'hover:bg-neutral-300');
          }
        });

        // Update content
        contents.forEach(content => {
          if (content.dataset.socialContent === target) {
            content.classList.remove('hidden');
            // Fade in animation
            content.style.opacity = '0';
            setTimeout(() => {
              content.style.transition = 'opacity 0.3s ease-in';
              content.style.opacity = '1';
            }, 10);

            // Reinitialize embeds when switching tabs
            if (target === 'tiktok') {
              setTimeout(() => {
                if (window.tiktokEmbed && typeof window.tiktokEmbed === 'function') {
                  window.tiktokEmbed();
                }
              }, 100);
            } else if (target === 'instagram') {
              setTimeout(() => {
                if (window.instgrm && window.instgrm.Embeds) {
                  window.instgrm.Embeds.process();
                }
              }, 100);
            }
          } else {
            content.classList.add('hidden');
          }
        });
      });
    });
  });
</script>

<style>
  .social-content {
    animation: fadeIn 0.3s ease-in;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .social-tab {
    position: relative;
  }

  .social-tab.active::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    width: 40%;
    height: 3px;
    background: currentColor;
    border-radius: 2px;
  }

  /* TikTok embed responsive sizing */
  #tiktok-embed-wrapper {
    min-height: 600px;
  }

  @media (min-width: 768px) {
    #tiktok-embed-wrapper {
      min-height: 700px;
    }
  }

  @media (min-width: 1024px) {
    #tiktok-embed-wrapper {
      min-height: 800px;
    }
  }

  /* Ensure TikTok iframe scales properly */
  .tiktok-embed iframe {
    width: 100% !important;
    min-height: 600px;
  }

  @media (min-width: 768px) {
    .tiktok-embed iframe {
      min-height: 700px;
    }
  }

  @media (min-width: 1024px) {
    .tiktok-embed iframe {
      min-height: 800px;
    }
  }
</style>
