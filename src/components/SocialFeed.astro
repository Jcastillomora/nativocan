---
// SocialFeed.astro
// Instagram and TikTok embedded feed section
---

<section class="py-16 md:py-24 bg-gradient-to-br from-primary/5 to-secondary/5">
  <div class="container mx-auto px-4 max-w-7xl">
    <div class="text-center mb-12">
      <h2 class="text-4xl md:text-5xl font-bold mb-4 text-neutral-900">
        Síguenos en Redes Sociales
      </h2>
      <p class="text-lg text-neutral-600 max-w-2xl mx-auto">
        Descubre nuestro día a día, tips de adiestramiento y los momentos más divertidos con nuestros peludos amigos
      </p>
    </div>

    <!-- Social Platform Tabs -->
    <div class="flex justify-center gap-4 mb-8">
      <button
        data-social-tab="instagram"
        class="social-tab active px-8 py-3 rounded-full font-semibold transition-all duration-300 bg-primary text-white shadow-md"
      >
        📷 Instagram
      </button>
      <button
        data-social-tab="tiktok"
        class="social-tab px-8 py-3 rounded-full font-semibold transition-all duration-300 bg-neutral-200 text-neutral-700 hover:bg-neutral-300"
      >
        🎵 TikTok
      </button>
    </div>

    <!-- Instagram Feed Section -->
    <div data-social-content="instagram" class="social-content">
      <div class="mb-8 text-center">
        <a
          href="https://www.instagram.com/nativocan.cl/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-primary hover:text-primary-dark transition-colors font-semibold text-lg"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          @nativocan.cl
        </a>
      </div>

      <!-- Instagram Embed Container -->
      <div class="instagram-feed-container">
        <!-- Instafeed.js - Free Instagram Feed -->
        <div id="instafeed" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4"></div>

        <!-- Loading state -->
        <div id="instafeed-loading" class="text-center py-12">
          <div class="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-primary"></div>
          <p class="text-neutral-600 mt-4">Cargando feed de Instagram...</p>
        </div>

        <!-- Error/Setup Instructions -->
        <div id="instafeed-setup" class="hidden mt-6 p-4 bg-blue-50 border border-blue-200 rounded-lg">
          <h4 class="font-semibold text-blue-900 mb-2">🔧 Configuración del Feed de Instagram (Gratis):</h4>
          <p class="text-sm text-blue-800 mb-3">
            Sigue las instrucciones en <code class="bg-blue-100 px-2 py-1 rounded">docs/INSTAGRAM_SETUP.md</code> para obtener tu Access Token.
          </p>
          <ol class="text-sm text-blue-800 space-y-1 ml-4 list-decimal">
            <li>Crear una App en Facebook Developers (gratis)</li>
            <li>Obtener tu Instagram Access Token</li>
            <li>Agregar el token en este componente</li>
            <li>Rebuild y el feed se mostrará automáticamente</li>
          </ol>
        </div>
      </div>
    </div>

    <!-- TikTok Feed Section -->
    <div data-social-content="tiktok" class="social-content hidden">
      <div class="mb-8 text-center">
        <a
          href="https://www.tiktok.com/@nativocan.cl"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-primary hover:text-primary-dark transition-colors font-semibold text-lg"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1-.1z"/>
          </svg>
          @nativocan.cl
        </a>
      </div>

      <!-- TikTok Embed Container -->
      <div class="tiktok-feed-container">
        <div class="flex justify-center">
          <blockquote class="tiktok-embed" cite="https://www.tiktok.com/@nativocan.cl" data-unique-id="nativocan.cl" data-embed-from="embed_page" data-embed-type="creator" style="max-width:780px; min-width:288px;">
            <section>
              <a target="_blank" href="https://www.tiktok.com/@nativocan.cl?refer=creator_embed">@nativocan.cl</a>
            </section>
          </blockquote>
        </div>
      </div>
    </div>

    <!-- CTA to follow -->
    <div class="text-center mt-12">
      <p class="text-neutral-600 mb-4">¿Te gusta nuestro contenido?</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="https://www.instagram.com/nativocan.cl/"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-gradient-to-r from-purple-500 to-pink-500 hover:from-purple-600 hover:to-pink-600 text-white font-semibold px-8 py-3 rounded-full transition-all duration-300 shadow-md hover:shadow-lg inline-flex items-center gap-2"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          Seguir en Instagram
        </a>
        <a
          href="https://www.tiktok.com/@nativocan.cl"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-gradient-to-r from-cyan-500 to-purple-500 hover:from-cyan-600 hover:to-purple-600 text-white font-semibold px-8 py-3 rounded-full transition-all duration-300 shadow-md hover:shadow-lg inline-flex items-center gap-2"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1-.1z"/>
          </svg>
          Seguir en TikTok
        </a>
      </div>
    </div>
  </div>
</section>

<!-- TikTok Embed Script -->
<script async src="https://www.tiktok.com/embed.js"></script>

<!-- Instafeed.js Library -->
<script src="https://cdn.jsdelivr.net/npm/instafeed.js@2.0.0/dist/instafeed.min.js"></script>

<script is:inline>
  // Instagram Feed Configuration
  // TODO: Replace 'YOUR_ACCESS_TOKEN' with your actual Instagram Access Token
  // See docs/INSTAGRAM_SETUP.md for instructions

  const INSTAGRAM_ACCESS_TOKEN = 'YOUR_ACCESS_TOKEN'; // Replace this!

  if (typeof Instafeed !== 'undefined' && INSTAGRAM_ACCESS_TOKEN !== 'YOUR_ACCESS_TOKEN') {
    const feed = new Instafeed({
      accessToken: INSTAGRAM_ACCESS_TOKEN,
      limit: 8, // Number of posts to show
      template: '<a href="{{link}}" target="_blank" rel="noopener noreferrer" class="instagram-post aspect-square bg-cover bg-center rounded-lg hover:opacity-90 transition-opacity relative overflow-hidden group" style="background-image: url({{image}});"><div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4"><div class="text-white text-sm"><span class="font-semibold">❤️ {{likes}}</span> <span class="ml-3">💬 {{comments}}</span></div></div></a>',
      after: function() {
        // Hide loading, show feed
        document.getElementById('instafeed-loading').classList.add('hidden');
      },
      error: function(error) {
        console.error('Instagram feed error:', error);
        document.getElementById('instafeed-loading').classList.add('hidden');
        document.getElementById('instafeed-setup').classList.remove('hidden');
      }
    });

    try {
      feed.run();
    } catch(e) {
      console.error('Instafeed error:', e);
      document.getElementById('instafeed-loading').classList.add('hidden');
      document.getElementById('instafeed-setup').classList.remove('hidden');
    }
  } else {
    // No access token configured
    document.getElementById('instafeed-loading').classList.add('hidden');
    document.getElementById('instafeed-setup').classList.remove('hidden');
  }
</script>

<script>
  // Social feed tab switching
  const tabs = document.querySelectorAll('[data-social-tab]');
  const contents = document.querySelectorAll('[data-social-content]');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.socialTab;

      // Update tabs
      tabs.forEach(t => {
        if (t.dataset.socialTab === target) {
          t.classList.remove('bg-neutral-200', 'text-neutral-700', 'hover:bg-neutral-300');
          t.classList.add('bg-primary', 'text-white', 'shadow-md', 'active');
        } else {
          t.classList.remove('bg-primary', 'text-white', 'shadow-md', 'active');
          t.classList.add('bg-neutral-200', 'text-neutral-700', 'hover:bg-neutral-300');
        }
      });

      // Update content
      contents.forEach(content => {
        if (content.dataset.socialContent === target) {
          content.classList.remove('hidden');
          // Fade in animation
          content.style.opacity = '0';
          setTimeout(() => {
            content.style.transition = 'opacity 0.3s ease-in';
            content.style.opacity = '1';
          }, 10);
        } else {
          content.classList.add('hidden');
        }
      });
    });
  });
</script>

<style>
  .social-content {
    animation: fadeIn 0.3s ease-in;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .social-tab {
    position: relative;
  }

  .social-tab.active::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    width: 40%;
    height: 3px;
    background: currentColor;
    border-radius: 2px;
  }
</style>
