---
interface Props {
  name: string;
  role: string;
  specialty: string;
  photo: string;
  bio: string;
  experience: string;
}

const { name, role, specialty, photo, bio, experience } = Astro.props;
---

<div class="bg-white rounded-lg shadow-md p-6 text-center">
  <div class="w-32 h-32 mx-auto mb-4 bg-neutral-200 rounded-full flex items-center justify-center text-5xl overflow-hidden hover:scale-105 transition-transform duration-300">
    👤
  </div>
  <h3 class="text-xl font-semibold mb-2 text-neutral-900">{name}</h3>
  <p class="text-primary font-medium mb-2">{role}</p>
  <p class="text-sm text-neutral-600 mb-3">{specialty}</p>
  <p class="text-neutral-700 mb-3">{bio}</p>
  <span class="inline-block bg-accent/10 text-accent px-3 py-1 rounded-full text-sm font-semibold">{experience}</span>
</div>
