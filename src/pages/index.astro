---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Modal from '../components/Modal.astro';
import TeamMember from '../components/TeamMember.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import PricingCard from '../components/PricingCard.astro';
import { siteData } from '../data/site.js';
import { trainingServices } from '../data/services.js';
import { hotelFeatures, hotelGallery } from '../data/hotel.js';
import { team } from '../data/team.js';
import { testimonials } from '../data/testimonials.js';
import { pricingPlans } from '../data/pricing.js';
import { faqs } from '../data/faqs.js';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import SocialFeed from '../components/SocialFeed.astro';

// Structured Data
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": `${Astro.site}#business`,
  "name": siteData.business.name,
  "alternateName": `${siteData.business.name} - ${siteData.business.tagline}`,
  "description": siteData.business.description,
  "url": Astro.site,
  "telephone": siteData.business.phone,
  "email": siteData.business.email,
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Huichahue Km 9",
    "addressLocality": "Padre Las Casas",
    "addressRegion": "La Araucanía",
    "postalCode": "4780000",
    "addressCountry": "CL"
  },
  "sameAs": [
    siteData.social.facebook,
    siteData.social.instagram
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const reviewSchemas = testimonials.map(t => ({
  "@context": "https://schema.org",
  "@type": "Review",
  "author": {
    "@type": "Person",
    "name": t.name
  },
  "reviewRating": {
    "@type": "Rating",
    "ratingValue": t.rating,
    "bestRating": "5"
  },
  "reviewBody": t.text,
  "itemReviewed": {
    "@type": "Service",
    "name": t.service,
    "provider": {
      "@id": `${Astro.site}#business`
    }
  }
}));
---
<Layout title={siteData.seo.title} description={siteData.seo.description}>
  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  {reviewSchemas.map(schema => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />
  ))}
  <Header />
  <Hero />

  <!-- Services Section -->
  <section id="servicios" class="py-16 md:py-24 bg-neutral-50">
    <div class="container mx-auto px-4 max-w-7xl">
      <h2 class="text-4xl md:text-5xl font-bold text-center mb-12 text-neutral-900">
        Nuestros Servicios de Adiestramiento
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8" data-stagger-container>
        {trainingServices.map(service => (
          <div data-stagger-item>
            <ServiceCard
              title={service.title}
              description={service.description}
              icon={service.icon}
              duration={service.duration}
              highlights={service.highlights}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Hotel Section -->
  <section id="hotel" class="py-16 md:py-24">
    <div class="container mx-auto px-4 max-w-7xl">
      <h2 class="text-4xl md:text-5xl font-bold text-center mb-12 text-neutral-900">
        Hotel Canino - Un Hogar Lejos de Casa
      </h2>

      <!-- Features alternating layout -->
      {hotelFeatures.map((feature, index) => (
        <div class={`flex flex-col md:flex-row gap-8 mb-12 items-center ${index % 2 === 1 ? 'md:flex-row-reverse' : ''}`}>
          <div class="md:w-1/2">
            <div class="bg-neutral-200 rounded-lg h-64 flex items-center justify-center text-6xl">
              {feature.icon}
            </div>
          </div>
          <div class="md:w-1/2">
            <h3 class="text-2xl md:text-3xl font-semibold mb-4 text-neutral-900">{feature.title}</h3>
            <p class="text-lg text-neutral-600">{feature.description}</p>
          </div>
        </div>
      ))}

      <!-- Gallery grid -->
      <h3 class="text-3xl font-bold text-center mb-8 mt-16 text-neutral-900">Galería de Instalaciones</h3>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        {hotelGallery.map((img, index) => (
          <div
            class="bg-neutral-200 rounded-lg h-48 cursor-pointer hover:opacity-90 transition-opacity flex items-center justify-center text-4xl"
            data-gallery-image
            data-image-index={index}
          >
            📷
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <section id="equipo" class="py-16 md:py-24 bg-primary/10">
    <div class="container mx-auto px-4 max-w-7xl">
      <h2 class="text-4xl md:text-5xl font-bold text-center mb-12 text-neutral-900">
        Nuestro Equipo Profesional
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {team.map(member => (
          <TeamMember
            name={member.name}
            role={member.role}
            specialty={member.specialty}
            photo={member.photo}
            bio={member.bio}
            experience={member.experience}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section id="testimonios" class="py-16 md:py-24 bg-neutral-50">
    <div class="container mx-auto px-4 max-w-7xl">
      <h2 class="text-4xl md:text-5xl font-bold text-center mb-12 text-neutral-900">
        Lo Que Dicen Nuestros Clientes
      </h2>

      <div class="relative" data-carousel>
        <div class="overflow-hidden">
          <div class="flex transition-transform duration-500" data-carousel-track>
            {testimonials.map(testimonial => (
              <div class="min-w-full md:min-w-[33.333%] px-4" data-carousel-slide>
                <TestimonialCard
                  name={testimonial.name}
                  dogName={testimonial.dogName}
                  photo={testimonial.photo}
                  rating={testimonial.rating}
                  text={testimonial.text}
                  service={testimonial.service}
                />
              </div>
            ))}
          </div>
        </div>

        <button
          class="absolute top-1/2 -translate-y-1/2 left-0 bg-white rounded-full p-3 shadow-lg hover:bg-neutral-100 transition-colors"
          data-carousel-prev
          aria-label="Anterior"
        >←</button>
        <button
          class="absolute top-1/2 -translate-y-1/2 right-0 bg-white rounded-full p-3 shadow-lg hover:bg-neutral-100 transition-colors"
          data-carousel-next
          aria-label="Siguiente"
        >→</button>

        <div class="flex justify-center gap-2 mt-8">
          {testimonials.map((_, index) => (
            <button
              class="w-3 h-3 rounded-full bg-neutral-300 transition-colors hover:bg-neutral-400"
              data-carousel-dot
              data-dot-index={index}
              aria-label={`Ir a testimonio ${index + 1}`}
            ></button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Section -->
  <section id="precios" class="py-16 md:py-24">
    <div class="container mx-auto px-4 max-w-7xl">
      <h2 class="text-4xl md:text-5xl font-bold text-center mb-12 text-neutral-900">
        Planes y Precios
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {pricingPlans.map(plan => (
          <PricingCard
            name={plan.name}
            category={plan.category}
            price={plan.price}
            duration={plan.duration}
            features={plan.features}
            popular={plan.popular}
            cta={plan.cta}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Social Feed Section -->
  <SocialFeed />

  <!-- SEO Content Section -->
  <section class="py-16 md:py-24 bg-neutral-50">
    <div class="container mx-auto px-4 max-w-4xl">
      <h2 class="text-4xl md:text-5xl font-bold text-center mb-12 text-neutral-900">
        ¿Por Qué Elegir Nativocan?
      </h2>

      <div class="prose prose-lg max-w-none space-y-8">
        <div>
          <h3 class="text-2xl md:text-3xl font-semibold mb-4 text-neutral-900">Beneficios del Adiestramiento Profesional</h3>
          <p class="text-lg text-neutral-700 leading-relaxed">
            El adiestramiento profesional es una inversión en la felicidad y seguridad de tu perro. Un perro bien entrenado no solo es más obediente, sino también más confiado y menos estresado. Nuestros programas de adiestramiento canino utilizan técnicas de refuerzo positivo basadas en la ciencia del comportamiento animal, asegurando que tu mascota aprenda de manera efectiva y disfrute del proceso. Ya sea que necesites obediencia básica para un cachorro o modificación de conducta para problemas específicos, nuestro equipo de entrenadores certificados tiene la experiencia para ayudarte. Los beneficios incluyen mejor comunicación entre tú y tu perro, reducción de comportamientos no deseados, y una relación más fuerte y armoniosa.
          </p>
        </div>

        <div>
          <h3 class="text-2xl md:text-3xl font-semibold mb-4 text-neutral-900">Qué Buscar en un Hotel Canino</h3>
          <p class="text-lg text-neutral-700 leading-relaxed">
            Elegir el hotel canino adecuado es crucial para la tranquilidad de tu mascota durante tu ausencia. Un buen hotel debe ofrecer instalaciones limpias y seguras, personal capacitado disponible 24/7, áreas de juego supervisadas, y atención personalizada. En Nativocan, entendemos que cada perro es único y requiere cuidados específicos. Nuestras instalaciones cuentan con espacios amplios, temperatura controlada, y monitoreo constante con cámaras de seguridad. Proporcionamos actualizaciones diarias con fotos y videos para que sepas que tu mejor amigo está feliz y bien cuidado. La alimentación de calidad, el ejercicio regular y el cariño son parte de nuestro servicio estándar.
          </p>
        </div>

        <div>
          <h3 class="text-2xl md:text-3xl font-semibold mb-4 text-neutral-900">Nuestra Filosofía de Entrenamiento</h3>
          <p class="text-lg text-neutral-700 leading-relaxed">
            Creemos firmemente en el adiestramiento basado en el refuerzo positivo. Esto significa recompensar los comportamientos deseados en lugar de castigar los no deseados. Este enfoque no solo es más efectivo, sino también más ético y respetuoso con el bienestar de tu perro. Nuestros métodos se fundamentan en décadas de investigación científica sobre comportamiento animal y psicología canina. No utilizamos collares de shock, castigos físicos ni técnicas aversivas. En cambio, trabajamos para entender las motivaciones de tu perro y usar recompensas que realmente valora. Esto crea una experiencia de aprendizaje positiva que fortalece el vínculo entre tú y tu mascota mientras desarrolla su confianza y habilidades.
          </p>
        </div>

        <div>
          <h3 class="text-2xl md:text-3xl font-semibold mb-4 text-neutral-900">Compromiso con el Bienestar Animal</h3>
          <p class="text-lg text-neutral-700 leading-relaxed">
            El bienestar de cada perro que nos confías es nuestra máxima prioridad. Esto va más allá del entrenamiento o el hospedaje: se trata de crear un entorno donde tu mascota se sienta segura, valorada y feliz. Nuestro equipo está capacitado en primeros auxilios veterinarios y reconocimiento de signos de estrés o malestar. Mantenemos protocolos estrictos de limpieza y desinfección, requerimos que todos los perros estén al día con sus vacunas, y tenemos planes de emergencia establecidos. Trabajamos en colaboración con veterinarios locales para garantizar que cualquier necesidad médica sea atendida de inmediato. Tu perro no es solo un cliente para nosotros, es un miembro temporal de nuestra familia que merece el mejor cuidado posible.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 md:py-24">
    <div class="container mx-auto px-4 max-w-4xl">
      <h2 class="text-4xl md:text-5xl font-bold text-center mb-12 text-neutral-900">
        Preguntas Frecuentes
      </h2>

      <div class="space-y-6">
        {faqs.map(faq => (
          <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
            <h3 class="text-xl font-semibold mb-3 text-neutral-900">{faq.question}</h3>
            <p class="text-neutral-700 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contacto" class="py-16 md:py-24 bg-neutral-50">
    <div class="container mx-auto px-4 max-w-7xl">
      <h2 class="text-4xl md:text-5xl font-bold text-center mb-12 text-neutral-900">
        Contáctanos
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-8">
        <!-- Form - 3 columns -->
        <div class="md:col-span-3">
          <ContactForm />
        </div>

        <!-- Contact Info - 2 columns -->
        <div class="md:col-span-2 space-y-6">
          <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-xl font-semibold mb-4 text-neutral-900">Información de Contacto</h3>
            <div class="space-y-4">
              <div>
                <p class="text-sm font-semibold text-neutral-600 mb-1">Teléfono</p>
                <a
                  href={`tel:${siteData.business.phone}`}
                  class="text-primary hover:text-primary-dark transition-colors text-lg font-medium"
                >
                  {siteData.business.phone}
                </a>
              </div>

              <div>
                <p class="text-sm font-semibold text-neutral-600 mb-1">Email</p>
                <a
                  href={`mailto:${siteData.business.email}`}
                  class="text-primary hover:text-primary-dark transition-colors break-all"
                >
                  {siteData.business.email}
                </a>
              </div>

              <div>
                <p class="text-sm font-semibold text-neutral-600 mb-1">Dirección</p>
                <p class="text-neutral-700">{siteData.business.address}</p>
              </div>

              <div>
                <p class="text-sm font-semibold text-neutral-600 mb-1">Horarios</p>
                <p class="text-neutral-700">{siteData.business.hours}</p>
              </div>
            </div>
          </div>

          <!-- Social buttons -->
          <div class="flex flex-col gap-3">
            <a
              href={`https://wa.me/${siteData.social.whatsapp}?text=${encodeURIComponent(siteData.social.whatsappMessage)}`}
              class="bg-green-500 hover:bg-green-600 text-white font-semibold px-6 py-3 rounded-full transition-colors text-center shadow-md hover:shadow-lg"
              target="_blank"
              rel="noopener noreferrer"
            >
              💬 WhatsApp
            </a>
            <a
              href={siteData.social.facebook}
              class="bg-secondary hover:bg-secondary-dark text-white font-semibold px-6 py-3 rounded-full transition-colors text-center shadow-md hover:shadow-lg"
              target="_blank"
              rel="noopener noreferrer"
            >
              📘 Facebook
            </a>
            <a
              href={siteData.social.instagram}
              class="bg-primary hover:bg-primary-dark text-white font-semibold px-6 py-3 rounded-full transition-colors text-center shadow-md hover:shadow-lg"
              target="_blank"
              rel="noopener noreferrer"
            >
              📷 Instagram
            </a>
          </div>

          <!-- Map placeholder -->
          <div class="bg-neutral-200 rounded-lg h-64 flex items-center justify-center">
            <p class="text-neutral-600 text-center px-4">
              🗺️ Mapa<br />
              <span class="text-sm">TODO: Embed Google Maps iframe</span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
  <BackToTop />
  <Modal />
</Layout>
